{
  "name": "syncspace-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root runner scripts for SyncSpace backend and frontend",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:prod": "npm --prefix backend run start:prod",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  }
}
